{
  "name": "marketfit-job-lens",
  "version": "0.7.24",
  "private": true,
  "type": "module",
  "description": "Chrome side-panel extension that analyses the current job page against your CV.",
  "scripts": {
    "test": "node --test tests/*.test.mjs && node scripts/smoke-test.mjs",
    "lint": "node scripts/static-check.mjs",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "icons": "node scripts/render-icons.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "npm run lint && npm test && npm run audit",
    "preversion": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200"
  }
}
